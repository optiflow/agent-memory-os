# Non-secret local adapter defaults. Copy to .env for local shells only.
#
# Build the CLI first:
# pnpm --filter @agent-memory-os/cli build

# Optional when `meta-memory` is on PATH or the built repo-local CLI can be found.
# Use an absolute path in real shells when you want to pin the command.
META_MEMORY_CLI="node /absolute/path/to/agent-memory-os/packages/cli/dist/index.js"

# Optional local SQLite database used by the Hermes adapter.
# If unset, the adapter uses Hermes home or ~/.hermes/meta-memory.sqlite.
META_MEMORY_DB="$HOME/.hermes/meta-memory.sqlite"

# Optional positive number of seconds before the Python adapter aborts a CLI subprocess.
META_MEMORY_TIMEOUT_SECONDS=20
