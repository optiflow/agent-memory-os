# Non-secret local adapter defaults. Copy to .env for local shells only.
#
# Build the CLI first:
# pnpm --filter @agent-memory-os/cli build

# Use an absolute path in real shells.
META_MEMORY_CLI="node /absolute/path/to/agent-memory-os/packages/cli/dist/index.js"

# Local SQLite database used by the Hermes adapter.
META_MEMORY_DB="$HOME/.hermes/meta-memory.sqlite"

# Positive number of seconds before the Python adapter aborts a CLI subprocess.
META_MEMORY_TIMEOUT_SECONDS=20
