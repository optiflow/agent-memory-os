{
  "name": "agent-memory-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "adapter:check": "python3 -m py_compile adapters/hermes/plugins/memory/meta_memory/__init__.py adapters/hermes/plugins/memory/meta_memory/test/test_provider.py && python3 -m unittest discover adapters/hermes/plugins/memory/meta_memory/test",
    "bench": "turbo run bench",
    "bench:ci": "turbo run bench:ci",
    "build": "turbo run build",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm adapter:check && pnpm eval && pnpm bench:ci",
    "clean": "turbo run clean",
    "eval": "turbo run eval",
    "format": "biome format --write .",
    "hooks:install": "lefthook install",
    "lint": "pnpm lint:packages && pnpm lint:repo",
    "lint:packages": "turbo run lint",
    "lint:repo": "biome check .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "25.9.1",
    "lefthook": "2.1.9",
    "turbo": "2.9.16",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.5.1"
  }
}
